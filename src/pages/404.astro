---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title='Page not found'>
    <div class='mx-auto w-full max-w-3xl px-4 py-20 text-center lg:px-6'>
        <p class='text-sm font-semibold text-primary'>404</p>
        <h1 class='mt-2 text-3xl font-bold tracking-tight'>Page not found</h1>
        <p class='mt-3 text-base-content/65'>The requested page does not exist.</p>
        <a class='btn mt-6 btn-primary' href={withBase('/')}>Go to the homepage</a>
    </div>
</BaseLayout>
