---
import { exercises } from '../../data/exercises';
import { withBase } from '../../lib/paths';

interface Props {
    currentSlug?: string;
    listActive?: boolean;
}

const { currentSlug, listActive = false } = Astro.props;
const navClass = (active: boolean) =>
    `grid h-auto min-h-8 w-full min-w-0 grid-cols-[auto_minmax(0,1fr)] whitespace-normal overflow-hidden${active ? ' bg-primary/12 font-semibold text-primary' : ''}`;
---

<ul class='menu w-full gap-0.5 menu-sm'>
    <li>
        <a href={withBase('/exercises')} class={navClass(listActive)} aria-current={listActive ? 'page' : undefined}
            ><span class='min-w-0 break-words'>All exercises</span></a
        >
    </li>
    <li class='mt-3'>
        <h2 class='menu-title'>Exercises</h2>
        <ul>
            {
                exercises.map((exercise, index) => (
                    <li>
                        <a
                            href={withBase(`/exercises/${exercise.slug}`)}
                            class={navClass(currentSlug === exercise.slug)}
                            aria-current={currentSlug === exercise.slug ? 'page' : undefined}
                        >
                            <span class='min-w-0 break-words'>
                                {index + 1}. {exercise.title}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </li>
</ul>
