---
interface Props {
    label: string;
}

const { label } = Astro.props;
---

<div
    class='my-4 flex min-h-32 items-center justify-center gap-2 border border-base-300 bg-base-100 text-sm text-base-content/60'
    aria-live='polite'
>
    <span class='loading loading-sm loading-spinner'></span>
    {label}
</div>
